# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# LLM Provider Configuration
# Set to 'gemini' to use Google Gemini 1.5 Flash (free tier available at https://aistudio.google.com/)
# Set to 'mock' for offline testing / development without any API key
LLM_PROVIDER=gemini

# Google AI Studio API Key (Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=
